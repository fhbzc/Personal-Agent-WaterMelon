# Release artifacts and build scratch space (regenerated by build.py)
/dist/
/build/.work/
*.spec

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Local validation output
validation-*.json

# Never commit credentials or developer-only configuration (section 113)
.env
secrets.json
credentials.json
*.pem
*.key

# ---------------------------------------------------------------------------
# Personal material. None of this belongs in a public repository.
# ---------------------------------------------------------------------------

# Business and correspondence drafts, and anything else written about the
# project rather than part of it.
/written_doc/

# A working reference written against the live database: it quotes real task
# titles and real counts from one person's installation.
/temp.txt

# The upload instructions themselves. They are addressed to one person and
# name their local paths.
/upload_instruction.txt

# ---------------------------------------------------------------------------
# Safety nets: the application's own data, wherever it is put.
#
# None of these exist in the tree today. They are listed so that running the
# agent from inside a checkout, which is the ordinary way to try it, cannot
# quietly stage a database of somebody's activity.
# ---------------------------------------------------------------------------
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log

# Coding-assistant transcripts, in any location.
*.jsonl
.claude/

# An agent root created in the working tree.
/agent_root/
/workspace/
/internal/
/AgentRoot/

# The test runner's measured times (scripts/run_tests.py): this machine's.
tests/.durations.json
